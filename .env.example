# ============================================================
# DATABASE (runtime)
# ============================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=alphaflow_intraday
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password

# ============================================================
# DOCKER (infrastructure)
# ============================================================
DOCKER_NETWORK_NAME=alphaflow_intraday_network
DOCKER_POSTGRES_VOLUME=alphaflow_intraday_postgres_data

DOCKER_IMAGE_POSTGRES=postgres:17-bookworm
DOCKER_IMAGE_DB_MIGRATE=migrate/migrate:4
DOCKER_IMAGE_NODE=node:26-alpine

LOCAL_SCRIPTS_VOLUME=./database/scripts
LOCAL_SEED_DATA_VOLUME=./database/data
LOCAL_MIGRATION_DATA_VOLUME=./database/migrations

DOCKER_SCRIPTS_VOLUME=/app/scripts
DOCKER_SEED_DATA_VOLUME=/app/data
DOCKER_MIGRATION_DATA_VOLUME=/app/migrations

# ============================================================
# BACKEND & FRONTEND
# ============================================================
SERVER_PORT=8081
NEXT_PUBLIC_API_URL=http://localhost:8081
CORS_ALLOWED_ORIGINS=http://localhost:5174

# ============================================================
# ANGEL ONE SMARTAPI CREDENTIALS
# ============================================================
ANGEL_ONE_API_KEY=your_angel_one_api_key
ANGEL_ONE_CLIENT_CODE=your_angel_one_client_code
ANGEL_ONE_PASSWORD=your_angel_one_password
ANGEL_ONE_TOTP_KEY=your_angel_one_totp_key

# ============================================================
# TELEGRAM NOTIFICATIONS
# ============================================================
TELEGRAM_API_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
